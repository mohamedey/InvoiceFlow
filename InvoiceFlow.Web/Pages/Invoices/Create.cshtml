@page
@model CreateModel
@{
    ViewData["Title"] = "Create Invoice";
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        Please fix the errors below.
    </div>
}

<div class="card card-custom p-4">
    <h3 class="mb-4 fw-bold">Create New Invoice</h3>

    <form method="post">

        <div class="mb-3">
            <label class="form-label">Customer Name</label>
            <select asp-for="Invoice.CustomerId" class="form-select" required>
                <option value="">-- Select Customer --</option>
                @foreach (var c in Model.Customers)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>

        <div class="mb-4">
            <label class="form-label">Due Date</label>
            <input asp-for="Invoice.DueDate" type="date" class="form-control" required />
        </div>

        <h5 class="fw-semibold mb-3">Invoice Items</h5>

        <div id="items-container"></div>

        <button type="button" class="btn btn-outline-secondary mb-3" onclick="addItem()">
            + Add Item
        </button>

        <div class="text-end">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-plus-circle-dotted"></i> Create Invoice
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let itemIndex = 0;

        function addItem() {
            const container = document.getElementById("items-container");

            const html = `
                <div class="card p-3 mb-3">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Product</label>
                            <select name="Invoice.Items[${itemIndex}].ProductId" class="form-select" required>
                                ${getProducts()}
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Quantity</label>
                            <input name="Invoice.Items[${itemIndex}].Quantity" type="number" min="1" class="form-control" required />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button" class="btn btn-danger w-100" onclick="this.closest('.card').remove()"><i class="bi bi-x-circle-fill"></i> Remove</button>
                        </div>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML("beforeend", html);
            itemIndex++;

        }

        function getProducts() {
            let options = '';
            @foreach (var p in Model.Products)
            {
                    <text>
                    options += `<option value="@p.Id">@p.Name</option>`;
                    </text>
            }
            return options;
        }
    </script>
}