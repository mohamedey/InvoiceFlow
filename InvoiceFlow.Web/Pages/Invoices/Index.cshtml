@page
@model IndexModel
@{
    ViewData["Title"] = "Invoices";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-light">My Invoices</h2>
    <a asp-page="/Invoices/Create" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill"></i> New Invoice
    </a>
</div>

<div class="card card-custom p-4">
    <div class="table-responsive">
        <table class="table table-modern mb-0">
            <thead>
                <tr>
                    <th><i class="bi bi-receipt"></i> Invoice</th>
                    <th><i class="bi bi-clipboard2-pulse"></i> Status</th>
                    <th><i class="bi bi-calculator"></i> Total</th>
                    <th class="text-end"><i class="bi bi-check2-circle"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Invoices.Any())
                {
                    foreach (var invoice in Model.Invoices)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">
                                    <a asp-page="/Invoices/Details"
                                       asp-route-id="@invoice.Id"
                                       class="text-decoration-none text-dark invoice-link">
                                        #@invoice.InvoiceNumber
                                    </a>
                                </div>
                                <small class="text-muted">
                                    @invoice.Id
                                </small>
                            </td>
                            <td>
                                <span class="status-badge">
                                    @invoice.Status
                                </span>
                            </td>
                            <td class="fw-semibold">
                                $@invoice.TotalAmount
                            </td>
                            <td class="text-end">

                                <a asp-page="/Invoices/Edit"
                                   asp-route-id="@invoice.Id"
                                   class="btn btn-success btn-sm me-2">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>

                                <a asp-page="/Invoices/Delete"
                                   asp-route-id="@invoice.Id"
                                   class="btn btn-danger btn-sm me-2">
                                    <i class="bi bi-trash3"></i> Delete
                                </a>

                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-5">
                            <div class="alert alert-info">
                                No invoices found
                            </div>
                            <p class="text-muted">
                                Start by creating your first invoice.
                            </p>
                            <a asp-page="/Invoices/Create"
                               class="btn btn-primary mt-2">
                                Create Invoice
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>