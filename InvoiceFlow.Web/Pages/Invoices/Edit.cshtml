@page "{id:guid}"
@model EditModel
@{
    ViewData["Title"] = "Edit Invoice";
}

<div class="card card-custom p-4">
    <h3 class="fw-bold mb-4">Edit Invoice</h3>

    <form method="post">

        <div class="mb-3">
            <label class="form-label">Customer Id</label>
            <input asp-for="Invoice.CustomerId" class="form-control" required />
        </div>

        <div class="mb-4">
            <label class="form-label">Due Date</label>
            <input asp-for="Invoice.DueDate" type="date" class="form-control" required />
        </div>

        <h5 class="fw-semibold mb-3">Invoice Items</h5>

        <div id="items-container">
            @for (int i = 0; i < Model.Invoice.Items.Count; i++)
            {
                <div class="card p-3 mb-3">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Product</label>
                            <select asp-for="Invoice.Items[@i].ProductId" class="form-select">
                                @foreach (var p in Model.Products)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Quantity</label>
                            <input asp-for="Invoice.Items[@i].Quantity"
                                   type="number"
                                   min="1"
                                   class="form-control" />
                        </div>

                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button"
                                    class="btn btn-danger w-100"
                                    onclick="this.closest('.card').remove()">
                                Remove
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <button type="button" class="btn btn-outline-secondary mb-3" onclick="addItem()">
            + Add Item
        </button>

        <div class="text-end">
            <a asp-page="/Invoices/Index" class="btn btn-light me-2">
                Cancel
            </a>
            <button type="submit" class="btn btn-primary px-4">
                Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let itemIndex = @Model.Invoice.Items.Count;

        function addItem() {
            const container = document.getElementById("items-container");

            const html = `
                <div class="card p-3 mb-3">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Product</label>
                            <select name="Invoice.Items[${itemIndex}].ProductId" class="form-select">
                                ${getProducts()}
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Quantity</label>
                            <input name="Invoice.Items[${itemIndex}].Quantity"
                                   type="number"
                                   min="1"
                                   class="form-control" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button"
                                    class="btn btn-danger w-100"
                                    onclick="this.closest('.card').remove()">
                                Remove
                            </button>
                        </div>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML("beforeend", html);
            itemIndex++;
        }

        function getProducts() {
            let options = '';
            @foreach (var p in Model.Products)
            {
                    <text>
                    options += `<option value="@p.Id">@p.Name</option>`;
                    </text>
            }
            return options;
        }
    </script>
}