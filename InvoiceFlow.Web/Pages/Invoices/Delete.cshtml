@page "{id:guid}"
@model DeleteModel
@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="card card-custom p-5 text-center">
    <div class="mb-4">
        <h3 class="fw-bold text-danger">Delete Invoice</h3>
        <p class="text-muted mt-3">
            Are you sure you want to delete invoice
            <strong>@Model.Invoice?.InvoiceNumber</strong>?
        </p>
    </div>

    <form method="post">
        <input type="hidden" name="id" value="@Model.Invoice?.Id" />

        <div class="d-flex justify-content-center gap-3">
            <a asp-page="/Invoices/Index" class="btn btn-outline-secondary px-4">
                Cancel
            </a>

            <button type="submit" class="btn btn-danger px-4">
                Delete
            </button>
        </div>
    </form>
</div>