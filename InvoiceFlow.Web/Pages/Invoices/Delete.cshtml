@page "{id:guid}"
@model DeleteModel
@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 p-5 text-center">

        <div class="mb-4">
            <div class="display-6 text-danger mb-3">
                ⚠ Confirm Deletion
            </div>

            <p class="fs-5 text-muted">
                You are about to delete invoice
            </p>

            <h4 class="fw-bold">
                #@Model.Invoice?.InvoiceNumber
            </h4>

            <p class="text-muted mt-3">
                This action cannot be undone.
            </p>
        </div>

        <form method="post">
            <input type="hidden" name="id" value="@Model.Invoice?.Id" />

            <div class="d-flex justify-content-center gap-3 mt-4">
                <a asp-page="/Invoices/Index"
                   class="btn btn-outline-secondary px-4">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>

                <button type="submit"
                        class="btn btn-danger px-4">
                    <i class="bi bi-trash"></i> Delete Permanently
                </button>
            </div>
        </form>

    </div>
</div>