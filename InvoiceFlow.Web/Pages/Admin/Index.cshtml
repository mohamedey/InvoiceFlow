@page
@model InvoiceFlow.Web.Pages.Admin.IndexModel

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="admin-layout">

    <aside class="admin-sidebar">
        <h2>Admin Panel</h2>

        <button class="sidebar-btn active" onclick="showSection('createUser')">
            Create User
        </button>

        <button class="sidebar-btn" onclick="showSection('roles')">
            Role Management
        </button>

        <button class="sidebar-btn" onclick="showSection('customers')">
            Customer Management
        </button>
    </aside>

    <main class="admin-content">

        <!-- CREATE USER -->
        <section id="createUser" class="admin-section active">
            <h3>Create New User</h3>

            <form method="post">
                <input type="email" asp-for="Email" placeholder="Email" required />
                <input type="password" asp-for="Password" placeholder="Password" required />
                <input type="text" asp-for="FullName" placeholder="Full Name" required />
                <button type="submit">Create</button>
            </form>
        </section>

        <!-- ROLE MANAGEMENT -->
        <section id="roles" class="admin-section">
            <h3>User Role Management</h3>

            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Current Role</th>
                        <th>Change</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td>
                                <form method="post" asp-page-handler="UpdateRole">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <select name="role">
                                        <option value="User">User</option>
                                        <option value="Admin">Admin</option>
                                    </select>
                                    <button type="submit">Update</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!string.IsNullOrEmpty(Model.RoleMessage))
            {
                <div class="message">
                    @Model.RoleMessage
                </div>
            }
        </section>

        <!-- CUSTOMER MANAGEMENT -->
        <section id="customers" class="admin-section">
            <h3>Customer Management</h3>

            <div class="customer-form">
                <form method="post" asp-page-handler="CreateCustomer">
                    <input asp-for="NewCustomer.Name" placeholder="Name" required />
                    <input asp-for="NewCustomer.Email" placeholder="Email" required />
                    <input asp-for="NewCustomer.Phone" placeholder="Phone" required />
                    <input asp-for="NewCustomer.Address" placeholder="Address" required />
                    <button type="submit">Add Customer</button>
                </form>
            </div>
            <hr />
            <br/>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>@c.Address</td>
                            <td>
                                <form method="post" asp-page-handler="DeleteCustomer">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!string.IsNullOrEmpty(Model.CustomerMessage))
            {
                <div class="message">
                    @Model.CustomerMessage
                </div>
            }
        </section>

    </main>
</div>

<script>
    function showSection(id) {
        document.querySelectorAll('.admin-section')
            .forEach(s => s.classList.remove('active'));

        document.querySelectorAll('.sidebar-btn')
            .forEach(b => b.classList.remove('active'));

        document.getElementById(id).classList.add('active');
        event.target.classList.add('active');
    }
</script>